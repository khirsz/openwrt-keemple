#include "qca953x.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "keemple,kp-gw-01", "qca,qca9531";
	model = "Keemple KP-GW-01";

	aliases {
		label-mac-device = &eth0;
		led-boot = &led_blue;
		led-failsafe = &led_red;
		led-running = &led_blue;
		led-upgrade = &led_green;
	};

	keys {
		compatible = "gpio-keys";

		pinctrl-names = "default";
		pinctrl-0 = <&jtag_disable_pins>;

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		front {
			label = "front";
			linux,code = <BTN_0>;
			gpios = <&gpio 3 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		buzzer {
			label = "buzzer";
			gpios = <&gpio 4 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_red: red {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			gpios = <&expander 0 GPIO_ACTIVE_HIGH>;
		};

		led_blue: blue {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&expander 1 GPIO_ACTIVE_HIGH>;
		};

		led_green: green {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&expander 2 GPIO_ACTIVE_HIGH>;
		};
	};

	i2c {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;

		sda-gpios = <&gpio 17 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 16 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;

		expander: gpio@20 {
			compatible = "nxp,pca9554";
			reg = <0x20>;

			gpio-controller;
			#gpio-cells = <2>;
		};
	};
};

&spi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x040000>;
				read-only;
			};

			partition@40000 {
				compatible = "u-boot,env";
				label = "u-boot-env";
				reg = <0x040000 0x010000>;
			};

			partition@50000 {
				label = "reserved";
				reg = <0x050000 0x020000>;
				read-only;
			};

			partition@70000 {
				label = "art";
				reg = <0x070000 0x010000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_art_0: macaddr@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};

					cal_art_1000: calibration@1000 {
						reg = <0x1000 0x440>;
					};
				};
			};
		};
	};

	flash@1 {
		compatible = "spi-nand";
		reg = <1>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "kernel";
				reg = <0x000000 0x400000>;
			};

			/*
			 * Vendor rootfs, gold-*, upgrade-* and security partitions.
			 * U-Boot erases upgrade-* on every boot if it holds no valid
			 * vendor image, so keep UBI out of this area.
			 */
			partition@400000 {
				label = "gdm";
				reg = <0x0400000 0x4420000>;
				read-only;
			};

			partition@4820000 {
				label = "ubi";
				reg = <0x4820000 0x37e0000>;
			};
		};
	};
};

&usb0 {
	status = "okay";
};

&usb_phy {
	status = "okay";
};

&eth0 {
	status = "okay";

	phy-handle = <&swphy4>;

	nvmem-cells = <&macaddr_art_0 0>;
	nvmem-cell-names = "mac-address";
};

// "Disable" unpopulated GMAC1

&eth1 {
	compatible = "syscon", "simple-mfd";
};

&wmac {
	status = "okay";

	nvmem-cells = <&cal_art_1000>;
	nvmem-cell-names = "calibration";
};

&pinmux {
	pinctrl-names = "default";
	pinctrl-0 = <&enable_gpio17>;

	enable_gpio17: pinmux_enable_gpio17 {
		pinctrl-single,bits = <0x10 0x0000 0xff00>;
	};
};
